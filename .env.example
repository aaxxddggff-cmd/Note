# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env

# โดเมนที่ชี้มาที่ VPS นี้ (Caddy จะขอใบรับรอง HTTPS ให้อัตโนมัติ)
DOMAIN=notes.example.com
# ที่อยู่เต็มของแอป ใช้ในลิงก์ที่ส่งทางอีเมล
PUBLIC_URL=https://notes.example.com

# เปิดให้คนทั่วไปสมัครเองได้ (1 = เปิด, 0 = ปิด ใช้ `--create-user` สร้างบัญชีให้แทน)
ALLOW_SIGNUP=1
# พื้นที่ไฟล์แนบต่อบัญชี (MB)
USER_QUOTA_MB=200

# อีเมลติดต่อสำหรับ Web Push (บริการ push ของ Google/Apple/Mozilla ใช้ติดต่อถ้ามีปัญหา)
PUSH_CONTACT=mailto:you@example.com

# ส่งอีเมล "ลืมรหัสผ่าน" (เว้นว่างได้ แต่ผู้ใช้ที่ลืมรหัสผ่านจะต้องติดต่อคุณให้รีเซ็ตให้)
# ใช้ได้กับบริการ SMTP ทั่วไป เช่น Gmail (App Password), Brevo, Mailgun, Amazon SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=สมุดสิ่งสำคัญ <no-reply@example.com>
